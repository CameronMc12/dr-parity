{
  "name": "dr-parity",
  "version": "0.1.0",
  "private": true,
  "description": "1:1 website and web app cloning engine with automated extraction, generation, and pixel-perfect QA",
  "author": "Cameron McAllister",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CameronMc12/dr-parity.git"
  },
  "homepage": "https://github.com/CameronMc12/dr-parity",
  "bugs": {
    "url": "https://github.com/CameronMc12/dr-parity/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "parity": "./bin/parity.ts"
  },
  "scripts": {
    "smoke:cli": "tsx scripts/smoke-parity-cli.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "generate:prototype": "tsx scripts/generate-prototype.ts",
    "generate:prototype:fixture": "tsx engine/generate/prototype/__fixtures__/run-fixture.ts",
    "generate:astro": "tsx scripts/generate-astro.ts",
    "generate:astro:fixture": "tsx engine/generate/astro/__fixtures__/run-fixture.ts",
    "build-astro": "tsx scripts/build-astro.ts",
    "build:astro": "tsx scripts/build.ts --target=astro",
    "build:react": "tsx scripts/build.ts --target=react",
    "build:react:multi": "tsx scripts/clone-urls.ts --target=react",
    "build:webapp": "tsx scripts/build.ts --target=webapp",
    "build:astro:multi": "tsx scripts/clone-urls.ts --target=astro",
    "test:parity:astro": "tsx engine/tests/multi-viewport-parity.spec.ts",
    "test:parity:react": "tsx engine/tests/multi-viewport-parity-react.spec.ts",
    "capture": "tsx scripts/capture.ts",
    "crawl:webapp": "tsx scripts/crawl-webapp.ts",
    "parse:har": "tsx scripts/parse-har.ts",
    "parse:trace": "tsx scripts/parse-trace.ts",
    "parse:all": "npm run parse:har -- $npm_config_dir && npm run parse:trace -- $npm_config_dir",
    "complete:assets": "tsx scripts/complete-assets.ts",
    "extract:css": "tsx scripts/extract-css.ts",
    "extract:primitives": "tsx scripts/extract-primitives.ts",
    "extract:tokens": "tsx scripts/extract-tokens.ts",
    "clone": "tsx scripts/clone.ts",
    "clone-site": "tsx scripts/clone-site.ts",
    "clone-urls": "tsx scripts/clone-urls.ts",
    "clone-end-to-end": "tsx scripts/run-clone.ts",
    "check:html-rewriter": "tsx scripts/check-html-rewriter.ts",
    "check:astro-emit": "tsx scripts/check-astro-emit.ts",
    "check:refactor": "tsx scripts/check-refactor.ts",
    "iconify:svgs": "tsx scripts/iconify-svgs.ts",
    "verify:parity": "tsx scripts/verify-parity.ts",
    "extract:animations": "tsx scripts/extract-animations.ts",
    "scope:styles": "tsx scripts/scope-styles.ts",
    "check:scope-styles": "tsx scripts/check-scope-styles.ts",
    "check:prettify": "tsx scripts/check-prettify.ts",
    "centralize:content": "tsx scripts/centralize-content.ts",
    "refactor:sections": "tsx scripts/refactor-sections.ts",
    "rebuild-pro": "tsx scripts/rebuild-pro.ts",
    "generate:edit-playbook": "tsx scripts/generate-edit-playbook.ts",
    "extract:library": "tsx scripts/extract-library.ts",
    "preview": "serve"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@tailwindcss/postcss": "^4",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^24",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^2.10.3",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "mime": "^4.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "yauzl": "^3.3.0",
    "zod": "^4.3.6"
  }
}
