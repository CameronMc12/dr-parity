{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "**/node_modules",
      "**/.next",
      "**/.turbo",
      "**/dist",
      "**/build",
      "**/coverage",
      "**/*.tsbuildinfo",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "tooling/**",
      "clones/**",
      "docs/research/crawl/**",
      "tooling/parity-harness/output/**"
    ]
  },
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": true,
      "trailingCommas": "all"
    }
  }
}
